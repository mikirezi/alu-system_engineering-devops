#!/usr/bin/env bash
# Installs and configures nginx on a new Ubuntu machine (run on web-01)
# - listens on port 80 (default)
# - serves a root page containing "Holberton School"
# - does not use systemctl

sudo apt-get update -y
sudo apt-get install -y nginx

echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null

sudo service nginx restart
