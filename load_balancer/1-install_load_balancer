#!/usr/bin/env bash
# Installs and configures HAProxy to load balance web-01 and web-02 (roundrobin)

sudo apt-get update -y
sudo apt-get install -y haproxy

sudo tee /etc/haproxy/haproxy.cfg > /dev/null <<'CFG'
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server 7340-web-01 13.135.254.60:80 check
    server 7340-web-02 13.40.178.57:80 check
CFG

# Enable init script management
echo "ENABLED=1" | sudo tee /etc/default/haproxy > /dev/null

sudo haproxy -c -f /etc/haproxy/haproxy.cfg
sudo service haproxy restart
