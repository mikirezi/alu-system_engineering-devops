#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080
pkill apache2
pkill nginx
chmod 644 /etc/nginx/nginx.conf
sed -i 's/#user www-data;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server;/listen 8080 default_server;/; s/listen \[::\]:80 default_server/listen [::]:8080 default_server/' /etc/nginx/sites-available/default
chown -R nginx:nginx /var/log/nginx /var/lib/nginx /etc/nginx
sed -i 's|^pid /run/nginx.pid;|pid /var/run/nginx.pid;|' /etc/nginx/nginx.conf
touch /var/run/nginx.pid
chown nginx:nginx /var/run/nginx.pid
su nginx -s /bin/bash -c "nginx"
